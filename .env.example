# Persona Council — environment variables
#
# Copy this file to .env and add at least ONE provider's API key.
# That's all you need to start. The model is picked in the UI from whichever
# providers you've configured a key for.

# ─────────────────────────────────────────────────────────────────────────
# Provider API keys (set at least ONE)
# ─────────────────────────────────────────────────────────────────────────

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter (optional) — unlocks Grok, DeepSeek, and acts as multi-provider fallback
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Ollama (optional) — run local / small models with NO API key
# ─────────────────────────────────────────────────────────────────────────
# Install from https://ollama.com, then `ollama serve` and `ollama pull llama3.2`.
# Locally-installed models appear in the UI dropdown automatically.
# Leave unset to use the default below. For Docker, point at the host:
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_HOST=http://localhost:11434
#
# Slow reasoning models (e.g. deepseek-r1) need a wide per-request timeout, since
# Ollama serializes the 5 parallel council members. Defaults usually suffice;
# bump these for very slow models / hardware, or if your server runs with a
# higher OLLAMA_NUM_PARALLEL.
# OLLAMA_TIMEOUT=300
# OLLAMA_MAX_CONCURRENCY=1

# ─────────────────────────────────────────────────────────────────────────
# Advanced (optional — most users won't need these)
# ─────────────────────────────────────────────────────────────────────────
# Set the default council mode for new conversations ("persona", "model", "hybrid").
# Users can override per-conversation in the UI.
# COUNCIL_MODE=persona
